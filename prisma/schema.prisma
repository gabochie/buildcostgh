generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  phone         String?
  accounts      Account[]
  sessions      Session[]
  orders        Order[]
  calculatorLeads CalculatorLead[]
  subscriptions Subscription[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Order {
  id        String   @id @default(cuid())
  userId    String?
  email     String
  fullName  String
  phone     String?
  package   String
  amount    Int
  currency  String   @default("GHS")
  status    String   @default("pending")
  reference String   @unique
  metadata  Json?
  reportUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User?    @relation(fields: [userId], references: [id])

  @@index([status])
  @@index([reference])
}

model ApiKey {
  id            String    @id @default(cuid())
  keyHash       String    @unique
  label         String
  tier          String    @default("dev")
  monthlyLimit  Int       @default(100)
  usageCount    Int       @default(0)
  lastResetAt   DateTime  @default(now())
  lastUsedAt    DateTime?
  active        Boolean   @default(true)
  ownerEmail    String?
  createdAt     DateTime  @default(now())
  expiresAt     DateTime?
}

model Job {
  id           String    @id @default(cuid())
  type         String
  payload      Json?
  status       String    @default("pending")
  attempts     Int       @default(0)
  maxAttempts  Int       @default(3)
  lastError    String?
  scheduledAt  DateTime  @default(now())
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status, scheduledAt])
}

model AgentLog {
  id          String   @id @default(cuid())
  agent       String
  action      String
  entityType  String?
  entityId    String?
  details     Json?
  level       String   @default("info")
  createdAt   DateTime @default(now())

  @@index([agent, createdAt])
  @@index([level])
}

model SeasonalFactor {
  id        String   @id @default(cuid())
  region    String?
  month     Int
  material  String?
  multiplier Float
  reason    String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([region, month, active])
}

model PriceUpdate {
  id         String   @id @default(cuid())
  tier       String
  oldAmount  Int
  newAmount  Int
  reason     String?
  approved   Boolean  @default(false)
  approvedBy String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model BlogPost {
  id        String   @id @default(cuid())
  title     String
  slug      String   @unique
  excerpt   String?
  content   String
  imageUrl  String?
  author    String
  published Boolean  @default(false)
  tags      String   @default("[]")
  category  String   @default("uncategorized")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
  @@index([published])
  @@index([category])
}

model Region {
  id        String @id @default(cuid())
  name      String @unique
  slug      String @unique
  contractors ContractorRegion[]
}

model FinishingGrade {
  id       String @id @default(cuid())
  name     String
  slug     String @unique
  minPrice Int
  maxPrice Int
  features String
}

model AddonOption {
  id          String @id @default(cuid())
  category    String
  label       String
  description String?
  minPrice    Int
  maxPrice    Int
}

model CalculatorLead {
  id        String   @id @default(cuid())
  email     String
  bedrooms  String?
  location  String?
  floorArea String?
  floors    String?
  completed Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])
  userId    String?
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  subscribed Boolean @default(true)
  createdAt DateTime @default(now())
}

model SiteSetting {
  id    String @id @default(cuid())
  key   String @unique
  value String
}

model Plan {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  priceMonthly Int
  priceAnnual  Int
  features    Json?
  popular     Boolean  @default(false)
  active      Boolean  @default(true)
  subscriptions Subscription[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Subscription {
  id                    String   @id @default(cuid())
  email                 String
  fullName              String?
  phone                 String?
  userId                String?
  planId                String
  status                String   @default("active")
  amount                Int?
  reference             String   @unique
  currentPeriodStart    DateTime @default(now())
  currentPeriodEnd      DateTime
  expresspayToken       String?
  transactionId         String?
  paystackSubscriptionCode String?
  cancelAtPeriodEnd     Boolean  @default(false)
  canceledAt            DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user User?  @relation(fields: [userId], references: [id])
  plan Plan   @relation(fields: [planId], references: [id])

  @@index([email])
  @@index([status])
  @@index([reference])
}

model Contractor {
  id               String   @id @default(cuid())
  name             String
  slug             String   @unique
  title            String?
  phone            String
  whatsapp         String?
  email            String?
  website          String?
  description      String
  specialties      Json     @default("[]")
  yearsOfExperience Int     @default(0)
  verified         Boolean  @default(false)
  insurance        String?
  licenseInfo      String?
  rating           Float    @default(0)
  reviewCount      Int      @default(0)
  portfolioImages  Json     @default("[]")
  logo             String?

  // ── Company profile ──
  companyType      String? // e.g. "Limited Liability", "Sole Proprietorship"
  legalName        String?
  yearEstablished  Int?
  registrationStatus String? // registered | not-verified | unknown
  contactPerson    String?

  // ── Location ──
  region           String? // Ghana admin region e.g. "Greater Accra", "Ashanti"
  district         String?
  city             String?
  locality         String?
  address          String?
  latitude         Float?
  longitude        Float?
  googlePlaceId    String?
  googleMapsUrl    String?

  // ── Classification (Ministry of Works & Housing / MRH) ──
  mwhBuildingClass   String? // D1-D4
  mwhCivilClass      String? // K1-K4
  mwhElectricalClass String? // E1-E3
  mwhPlumbingClass   String? // G1-G2
  mrhRoadClass       String? // MRH road classification
  classificationSource String? // "Ministry of Works and Housing" | "Ministry of Roads & Highways" | null
  classificationVerifiedAt DateTime?
  classificationExpiry DateTime?
  classificationNotVerified Boolean @default(false) // true when evidence is insufficient

  // ── Project scale ──
  projectScale     String? // Small | Medium | Large | Major | Enterprise

  // ── Digital presence / Google ──
  googleRating     Float?
  googleReviewCount Int?
  googleLastChecked DateTime?
  socialProfiles   Json     @default("{}") // { facebook?, instagram?, linkedin?, youtube?, x? }

  // ── Verification & data quality ──
  verificationLevel Int    @default(0) // 0-5 per Master Prompt §9
  dataConfidence   Int      @default(50) // 0-100
  lastVerifiedAt   DateTime?
  nextVerificationAt DateTime?

  // ── Marketplace ──
  featured         Boolean  @default(false)
  sponsored        Boolean  @default(false)

  regions          ContractorRegion[]
  sources          ContractorSource[]
  projects         ContractorProject[]
  status           String   @default("active")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([status, verified])
  @@index([slug])
  @@index([region])
  @@index([mwhBuildingClass])
  @@index([featured])
}

model ContractorSource {
  id           String     @id @default(cuid())
  contractorId String
  contractor   Contractor @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  tier         String     @default("secondary") // official | primary | secondary | user-generated
  label        String
  url          String?
  discoveredAt DateTime   @default(now())
  lastVerifiedAt DateTime?
  confidence   Int        @default(50) // 0-100

  @@index([contractorId])
}

model ContractorProject {
  id           String     @id @default(cuid())
  contractorId String
  contractor   Contractor @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  name         String
  type         String? // Residential | Commercial | Institutional | Infrastructure | Industrial
  location     String?
  year         Int?
  value        Float? // GHS
  description  String?
  imageUrl     String?
  sort         Int        @default(0)

  @@index([contractorId])
}

model ClassificationGrade {
  id          String @id @default(cuid())
  category    String // building | civil | electrical | plumbing | road
  grade       String // D1, D2, K1, E1, G1, MRH-A, ...
  title       String
  description String?
  sort        Int    @default(0)

  @@unique([category, grade])
  @@index([category])
}

model ContractorRegion {
  id           String     @id @default(cuid())
  contractorId String
  regionId     String
  contractor   Contractor @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  region       Region     @relation(fields: [regionId], references: [id], onDelete: Cascade)

  @@unique([contractorId, regionId])
}

model AdminLoginAttempt {
  id        String   @id @default(cuid())
  email     String
  ip        String?
  success   Boolean
  createdAt DateTime @default(now())

  @@index([ip, createdAt])
}

model CofounderGoal {
  id          String   @id @default(cuid())
  title       String
  description String?
  targetAmount Float
  currency    String   @default("USD")
  periodStart DateTime @default(now())
  periodEnd   DateTime
  status      String   @default("active") // active | completed | archived
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CofounderTask {
  id          String    @id @default(cuid())
  goalId      String?
  title       String
  agent       String // subagent key: sdr | content | pricing | research | ops
  status      String    @default("pending") // pending | running | completed | failed
  prompt      String
  result      String?
  error       String?
  createdAt   DateTime  @default(now())
  startedAt   DateTime?
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt

  @@index([goalId, status])
  @@index([agent])
}
