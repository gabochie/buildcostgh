generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  phone         String?
  passwordHash  String?
  role          String    @default("customer") // customer | admin | super_admin
  accounts      Account[]
  sessions      Session[]
  orders        Order[]
  calculatorLeads CalculatorLead[]
  subscriptions Subscription[]
  passwordResets PasswordReset[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PasswordReset {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Order {
  id            String   @id @default(cuid())
  userId        String?
  email         String
  fullName      String
  phone         String?
  package       String
  amount        Int
  currency      String   @default("GHS")
  status        String   @default("pending")
  reference     String   @unique
  referenceId   String?
  transactionId String?
  paymentGateway String?
  gatewayRef    String?
  metadata      Json?
  reportUrl     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User?    @relation(fields: [userId], references: [id])

  @@index([status])
  @@index([reference])
  @@index([referenceId])
  @@index([paymentGateway])
}

model ApiKey {
  id            String    @id @default(cuid())
  keyHash       String    @unique
  label         String
  tier          String    @default("dev")
  monthlyLimit  Int       @default(100)
  usageCount    Int       @default(0)
  lastResetAt   DateTime  @default(now())
  lastUsedAt    DateTime?
  active        Boolean   @default(true)
  ownerEmail    String?
  createdAt     DateTime  @default(now())
  expiresAt     DateTime?
}

model Job {
  id           String    @id @default(cuid())
  type         String
  payload      Json?
  status       String    @default("pending")
  attempts     Int       @default(0)
  maxAttempts  Int       @default(3)
  lastError    String?
  scheduledAt  DateTime  @default(now())
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status, scheduledAt])
}

model AgentLog {
  id          String   @id @default(cuid())
  agent       String
  action      String
  entityType  String?
  entityId    String?
  details     Json?
  level       String   @default("info")
  createdAt   DateTime @default(now())

  @@index([agent, createdAt])
  @@index([level])
}

model SeasonalFactor {
  id        String   @id @default(cuid())
  region    String?
  month     Int
  material  String?
  multiplier Float
  reason    String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([region, month, active])
}

model PriceUpdate {
  id         String   @id @default(cuid())
  tier       String
  oldAmount  Int
  newAmount  Int
  reason     String?
  approved   Boolean  @default(false)
  approvedBy String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model BlogPost {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  excerpt     String?
  content     String
  imageUrl    String?
  author      String
  authorBio   String?
  faqJson     String?  @default("[]")
  schemaType  String   @default("Article")
  published   Boolean  @default(false)
  tags        String   @default("[]")
  category    String   @default("uncategorized")
  readTimeMin Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([slug])
  @@index([published])
  @@index([category])
}

model Region {
  id        String @id @default(cuid())
  name      String @unique
  slug      String @unique
  contractors ContractorRegion[]
}

model FinishingGrade {
  id       String @id @default(cuid())
  name     String
  slug     String @unique
  minPrice Int
  maxPrice Int
  features String
}

model AddonOption {
  id          String @id @default(cuid())
  category    String
  label       String
  description String?
  minPrice    Int
  maxPrice    Int
}

model CalculatorLead {
  id        String   @id @default(cuid())
  email     String
  bedrooms  String?
  location  String?
  floorArea String?
  floors    String?
  completed Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])
  userId    String?
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  subscribed Boolean @default(true)
  createdAt DateTime @default(now())
}

model SiteSetting {
  id    String @id @default(cuid())
  key   String @unique
  value String
}

model Plan {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  priceMonthly Int
  priceAnnual  Int
  features    Json?
  popular     Boolean  @default(false)
  active      Boolean  @default(true)
  subscriptions Subscription[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Subscription {
  id                    String   @id @default(cuid())
  email                 String
  fullName              String?
  phone                 String?
  userId                String?
  planId                String
  status                String   @default("active")
  amount                Int?
  reference             String   @unique
  currentPeriodStart    DateTime @default(now())
  currentPeriodEnd      DateTime
  expresspayToken       String?
  transactionId         String?
  paystackSubscriptionCode String?
  paymentGateway        String?
  gatewayRef            String?
  cancelAtPeriodEnd     Boolean  @default(false)
  canceledAt            DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user User?  @relation(fields: [userId], references: [id])
  plan Plan   @relation(fields: [planId], references: [id])

  @@index([email])
  @@index([status])
  @@index([reference])
}

model Contractor {
  id               String   @id @default(cuid())
  name             String
  slug             String   @unique
  title            String?
  phone            String
  whatsapp         String?
  email            String?
  website          String?
  description      String
  specialties      Json     @default("[]")
  yearsOfExperience Int     @default(0)
  verified         Boolean  @default(false)
  insurance        String?
  licenseInfo      String?
  rating           Float    @default(0)
  reviewCount      Int      @default(0)
  portfolioImages  Json     @default("[]")
  logo             String?

  // ── Company profile ──
  companyType      String? // e.g. "Limited Liability", "Sole Proprietorship"
  legalName        String?
  yearEstablished  Int?
  registrationStatus String? // registered | not-verified | unknown
  contactPerson    String?

  // ── Location ──
  region           String? // Ghana admin region e.g. "Greater Accra", "Ashanti"
  district         String?
  city             String?
  locality         String?
  address          String?
  latitude         Float?
  longitude        Float?
  googlePlaceId    String?
  googleMapsUrl    String?

  // ── Classification (Ministry of Works & Housing / MRH) ──
  mwhBuildingClass   String? // D1-D4
  mwhCivilClass      String? // K1-K4
  mwhElectricalClass String? // E1-E3
  mwhPlumbingClass   String? // G1-G2
  mrhRoadClass       String? // MRH road classification
  classificationSource String? // "Ministry of Works and Housing" | "Ministry of Roads & Highways" | null
  classificationVerifiedAt DateTime?
  classificationExpiry DateTime?
  classificationNotVerified Boolean @default(false) // true when evidence is insufficient

  // ── Project scale ──
  projectScale     String? // Small | Medium | Large | Major | Enterprise

  // ── Digital presence / Google ──
  googleRating     Float?
  googleReviewCount Int?
  googleLastChecked DateTime?
  socialProfiles   Json     @default("{}") // { facebook?, instagram?, linkedin?, youtube?, x? }

  // ── Verification & data quality ──
  verificationLevel Int    @default(0) // 0-5 per Master Prompt §9
  dataConfidence   Int      @default(50) // 0-100
  lastVerifiedAt   DateTime?
  nextVerificationAt DateTime?

  // ── Marketplace ──
  featured         Boolean  @default(false)
  sponsored        Boolean  @default(false)

  regions          ContractorRegion[]
  sources          ContractorSource[]
  projects         ContractorProject[]
  status           String   @default("active")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([status, verified])
  @@index([slug])
  @@index([region])
  @@index([mwhBuildingClass])
  @@index([featured])
}

model ContractorSource {
  id           String     @id @default(cuid())
  contractorId String
  contractor   Contractor @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  tier         String     @default("secondary") // official | primary | secondary | user-generated
  label        String
  url          String?
  discoveredAt DateTime   @default(now())
  lastVerifiedAt DateTime?
  confidence   Int        @default(50) // 0-100

  @@index([contractorId])
}

model ContractorProject {
  id           String     @id @default(cuid())
  contractorId String
  contractor   Contractor @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  name         String
  type         String? // Residential | Commercial | Institutional | Infrastructure | Industrial
  location     String?
  year         Int?
  value        Float? // GHS
  description  String?
  imageUrl     String?
  sort         Int        @default(0)

  @@index([contractorId])
}

model ClassificationGrade {
  id          String @id @default(cuid())
  category    String // building | civil | electrical | plumbing | road
  grade       String // D1, D2, K1, E1, G1, MRH-A, ...
  title       String
  description String?
  sort        Int    @default(0)

  @@unique([category, grade])
  @@index([category])
}

model ContractorRegion {
  id           String     @id @default(cuid())
  contractorId String
  regionId     String
  contractor   Contractor @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  region       Region     @relation(fields: [regionId], references: [id], onDelete: Cascade)

  @@unique([contractorId, regionId])
}

model AdminLoginAttempt {
  id        String   @id @default(cuid())
  email     String
  ip        String?
  success   Boolean
  createdAt DateTime @default(now())

  @@index([ip, createdAt])
}

model RateLimitEntry {
  id        String   @id @default(cuid())
  key       String   // e.g. "ip:/api/calculator" or "ip:/api/register"
  count     Int      @default(1)
  windowStart DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([key, windowStart])
  @@unique([key])
}

model RegionRate {
  id          String   @id @default(cuid())
  name        String   @unique // "Greater Accra"
  slug        String   @unique // "greater-accra"
  capital     String   // "Accra"
  multiplier  Float    @default(1.0) // vs Accra baseline
  labourRate  Int      @default(0) // typical artisan day rate GHS
  cementBag   Int      @default(0) // per 50kg bag
  rebarTon    Int      @default(0) // per tonne
  block       Int      @default(0) // per block
  sandTrip    Int      @default(0) // per tipper trip
  graniteTrip Int      @default(0) // per tipper trip
  timber      Int      @default(0) // per standard length
  roofingSqm  Int      @default(0) // per SQM installed
  dieselLit   Int      @default(0) // per litre
  paintLit    Int      @default(0) // per litre
  source      String?  // e.g. "Supplier survey + NPA benchmark, Aug 2026"
  notes       String?
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([published])
  @@index([multiplier])
}

model CofounderGoal {
  id          String   @id @default(cuid())
  title       String
  description String?
  targetAmount Float
  currency    String   @default("USD")
  periodStart DateTime @default(now())
  periodEnd   DateTime
  status      String   @default("active") // active | completed | archived
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CofounderTask {
  id          String    @id @default(cuid())
  goalId      String?
  title       String
  agent       String // subagent key: sdr | content | pricing | research | ops
  status      String    @default("pending") // pending | running | completed | failed
  prompt      String
  result      String?
  error       String?
  createdAt   DateTime  @default(now())
  startedAt   DateTime?
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt

  @@index([goalId, status])
  @@index([agent])
}

model ContentDraft {
  id          String   @id @default(cuid())
  kind        String   @default("social") // social | blog
  title       String
  caption     String   // social caption / post body
  body        String?  // extended blog/thread body (optional)
  offer       Json?    // { headline, detail, expiresInDays?, cta? }
  platforms   Json     @default("[]") // ["facebook","instagram","x","linkedin","tiktok"]
  status      String   @default("draft") // draft | approved | rejected | published
  reviewNote  String?
  source      String?  // e.g. "content-agent"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  approvedAt  DateTime?
  publishedAt DateTime?

  posts SocialPost[]

  @@index([status, createdAt])
}

model SocialPost {
  id          String        @id @default(cuid())
  draftId     String?
  platform    String        // facebook | instagram | x | linkedin | tiktok | manual
  status      String        @default("pending") // pending | published | failed | manual
  externalUrl String?
  error       String?
  scheduledAt DateTime?
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  draft ContentDraft? @relation(fields: [draftId], references: [id], onDelete: SetNull)

  @@index([platform, status])
  @@index([draftId])
}

// ═══════════════════════════════════════════════════════════
// BUILDING TYPE TAXONOMY & COST PROFILES (Master Upgrade)
// ═══════════════════════════════════════════════════════════

model BuildingCategory {
  id          String            @id @default(cuid())
  name        String            @unique // "Residential", "Commercial", etc.
  slug        String            @unique
  description String?
  icon        String?           // lucide icon name
  sortOrder   Int               @default(0)
  isActive    Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  subtypes    BuildingSubtype[]
  costProfiles CostProfile[]
}

model BuildingSubtype {
  id          String            @id @default(cuid())
  categoryId  String
  category    BuildingCategory  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name        String            // "Single-family house", "Office building", etc.
  slug        String            @unique
  description String?
  complexity  String            @default("standard") // low | standard | high | very_high
  typicalMinFloors Int          @default(1)
  typicalMaxFloors Int          @default(5)
  sortOrder   Int               @default(0)
  isActive    Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  costProfiles CostProfile[]

  @@index([categoryId])
}

model CostProfile {
  id          String   @id @default(cuid())
  categoryId  String
  category    BuildingCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  subtypeId   String?
  subtype     BuildingSubtype? @relation(fields: [subtypeId], references: [id], onDelete: SetNull)
  qualityLevel String  // economy | standard | good | premium | luxury

  // Base cost per sqm (GHS)
  baseCostPerSqm Decimal @default(0)

  // Elemental breakdown percentages (must sum to ~1.0)
  substructurePct     Decimal @default(0.12)
  framePct            Decimal @default(0.18)
  upperFloorsPct      Decimal @default(0.10)
  roofPct             Decimal @default(0.10)
  externalWallsPct    Decimal @default(0.08)
  windowsDoorsPct     Decimal @default(0.07)
  internalFinishesPct Decimal @default(0.15)
  externalFinishesPct Decimal @default(0.04)
  fittingsPct         Decimal @default(0.03)
  mechanicalPct       Decimal @default(0.05)
  electricalPct       Decimal @default(0.05)
  fireProtectionPct   Decimal @default(0.01)

  // Cost components as % of construction cost
  externalWorksPct    Decimal @default(0.10)
  siteDevelopmentPct  Decimal @default(0.05)

  // Professional fees as % of construction cost
  architectFeePct     Decimal @default(0.08)
  qsFeePct            Decimal @default(0.04)
  structuralEngFeePct Decimal @default(0.04)
  civilEngFeePct      Decimal @default(0.02)
  mechanicalEngFeePct Decimal @default(0.02)
  electricalEngFeePct Decimal @default(0.02)
  geotechFeePct       Decimal @default(0.01)
  pmFeePct            Decimal @default(0.03)

  // Contingency + escalation
  contingencyPct      Decimal @default(0.10)
  escalationPct       Decimal @default(0.05)

  // Range width factor (1.0 = ±15%, 1.5 = ±25%)
  rangeFactor         Decimal @default(1.0)

  // Data quality
  confidenceLevel     String  @default("medium") // low | medium | high
  source              String? // "BuildCostGH 2026", "QS estimate", etc.
  lastReviewed        DateTime?
  isActive            Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([categoryId, subtypeId, qualityLevel])
  @@index([categoryId])
  @@index([qualityLevel])
}

// ═══════════════════════════════════════════════════════════
// PERMIT INTELLIGENCE (Master Upgrade §25-28)
// ═══════════════════════════════════════════════════════════

model PermitRequirement {
  id          String   @id @default(cuid())
  name        String   // "Site plan", "Architectural drawings", etc.
  description String?
  category    String   // "documentation" | "approval" | "inspection" | "certification"
  required    String   @default("required") // required | likely | conditional | not_normally | verify
  appliesTo   Json     // { buildingCategories: ["commercial","industrial"], minFloors: 3, minArea: 500, specialUses: ["healthcare"] }
  authority   String?  // "MMDA" | "EPA" | "GIFEC" | "Ghana Fire Service" | etc.
  source      String?  // legal reference / URL
  notes       String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([required])
  @@index([isActive])
}

model Authority {
  id            String   @id @default(cuid())
  name          String   // "Accra Metropolitan Assembly"
  type          String   // "MMDA" | "National" | "Sector" | "Professional"
  region        String
  district      String?
  website       String?
  phone         String?
  email         String?
  address       String?
  permitProcess Json?    // { steps: [...], estimatedTimeline: "...", fees: "..." }
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([region])
  @@index([type])
  @@index([isActive])
}

// ═══════════════════════════════════════════════════════════
// PROJECT SAVING & SCENARIO COMPARISON (Master Upgrade §30-31)
// ═══════════════════════════════════════════════════════════

model SavedEstimate {
  id            String   @id @default(cuid())
  userId        String?
  email         String?
  projectName   String
  buildingType  String   @default("residential")  // "residential" | category slug
  location      String
  floorArea     Decimal  @default(0)
  floors        Int      @default(1)
  qualityLevel  String   @default("standard")
  inputs        Json     // full calculator step data
  result        Json     // full EstimateResult
  version       Int      @default(1)            // increments when estimate is regenerated
  groupId       String?  // links scenarios together (same base project, different options)
  notes         String?
  isFavorite    Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
  @@index([email])
  @@index([groupId])
  @@index([createdAt])
}

// ═══════════════════════════════════════════════════════════
// DATA VERSIONING & AUDIT LOG (Master Upgrade §48-49)
// ═══════════════════════════════════════════════════════════

model DataVersion {
  id            String   @id @default(cuid())
  modelName     String   // e.g. "BuildingCategory", "CostProfile", "PermitRequirement"
  recordId      String   // ID of the record that changed
  version       Int      @default(1)
  snapshot      Json     // full record data at this version
  changeType    String   // "create" | "update" | "delete"
  changedBy     String?  // userId or "system" or "seed"
  reason        String?  // why this change was made
  createdAt     DateTime @default(now())

  @@index([modelName, recordId])
  @@index([changedBy])
  @@index([createdAt])
}

model AuditLog {
  id            String   @id @default(cuid())
  userId        String?
  email         String?
  action        String   // "estimate_created" | "estimate_deleted" | "admin_update" | "login" | "password_reset" | "rate_limited"
  resource      String?  // "estimate" | "user" | "building_type" | "permit" | "rates"
  resourceId    String?  // ID of affected resource
  details       Json?    // { ...contextual data }
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime @default(now())

  @@index([userId])
  @@index([email])
  @@index([action])
  @@index([resource, resourceId])
  @@index([createdAt])
}
