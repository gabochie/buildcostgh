# ==============================================================================
# BuildCost GH — environment configuration
# Copy this file to `.env.local` (development) or set these in your host
# (Vercel) and fill in real values. Values below are illustrative placeholders.
# ==============================================================================

# ------------------------------------------------------------------------------
# REQUIRED — the app will not boot (in production) without these.
# ------------------------------------------------------------------------------

# Postgres connection string (Prisma).
DATABASE_URL="postgresql://user:password@localhost:5432/buildcostgh?schema=public"

# Session/CSRF signing secret. Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Admin dashboard credentials (single-user admin login).
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Public base URL of the app (no trailing slash).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# REQUIRED BY FEATURES — several features hard-disable themselves when unset.
# ------------------------------------------------------------------------------

# Bearer token securing long-running job endpoints (/api/jobs/process etc.)
# and the Vercel cron invocations. Generate with: openssl rand -hex 32
CRON_SECRET=""

# Separate secret for report download tokens. Defaults to AUTH_SECRET if unset.
REPORT_TOKEN_SECRET=""

# OAuth-agnostic CSRF secret for non-session form submissions.
CSRF_SECRET=""

# Fallback USD->GHS FX rate used only when the live rate fetch fails.
USD_GHS_FALLBACK_RATE="15.5"

# Directory (outside public/) where generated reports are stored. Gitignored.
REPORT_DIR="reports-storage"

# Comma-separated list of payment gateways to expose at checkout.
# Empty = expose every configured gateway. Options: momo, expresspay, moolre, card.
PAYMENT_GATEWAYS="momo,expresspay,moolre,card"

# ------------------------------------------------------------------------------
# PAYMENTS (Moolre) — hosted checkout + verification. Optional; disabled when unset.
#   sandbox needs ACCOUNT_NUMBER + API_USER; production also needs PUBLIC_KEY.
# ------------------------------------------------------------------------------
MOOLRE_ENV="sandbox"                # sandbox | production
MOOLRE_ACCOUNT_NUMBER=""
MOOLRE_API_USER=""
MOOLRE_PUBLIC_KEY=""

# ------------------------------------------------------------------------------
# PAYMENTS (MTN Mobile Money) — optional; disabled when unset.
# ------------------------------------------------------------------------------
MOMO_ENVIRONMENT="sandbox"            # sandbox | production
MOMO_TARGET_ENVIRONMENT="mtnghana"
MOMO_API_USER=""
MOMO_API_KEY=""
MOMO_SUBSCRIPTION_KEY=""
MOMO_CALLBACK_URL="https://buildcostgh.com/api/payments/momo/callback"

# ------------------------------------------------------------------------------
# PAYMENTS (Paystack) — optional; disabled when unset.
# ------------------------------------------------------------------------------
PAYSTACK_SECRET_KEY=""
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=""

# ------------------------------------------------------------------------------
# PAYMENTS (ExpressPay) — optional; disabled when unset. ExpressPay's hosted
# checkout accepts Mobile Money, Ghana Pay, and cards.
# ------------------------------------------------------------------------------
EXPRESSPAY_MERCHANT_ID=""
EXPRESSPAY_API_KEY=""
EXPRESSPAY_ENV="sandbox"              # sandbox | production

# ------------------------------------------------------------------------------
# EMAIL
# ------------------------------------------------------------------------------
RESEND_API_KEY=""                     # transactional email + renewal reminders
GMAIL_USER=""                         # fallback SMTP sender (optional)
GMAIL_APP_PASSWORD=""

# ------------------------------------------------------------------------------
# ERROR OBSERVABILITY (Sentry, free Developer plan) — optional.
# Errors-only SDK, no tracing/replay. With no DSN every observe.* call is a
# no-op. Never attach a card: over-quota events are dropped, never billed.
# ------------------------------------------------------------------------------
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""

# ------------------------------------------------------------------------------
# WEB PUSH (PWA push notifications) — optional. Generate with:
#   npx web-push generate-vapid-keys
# Public key is exposed to the browser; private key stays server-side.
# ------------------------------------------------------------------------------
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:hello@buildcostgh.com"

# ------------------------------------------------------------------------------
# BOT PROTECTION (Cloudflare Turnstile) — optional; disabled when unset.
# ------------------------------------------------------------------------------
TURNSTILE_SECRET=""
NEXT_PUBLIC_TURNSTILE_SITEKEY=""

# ------------------------------------------------------------------------------
# AI / CONTENT-GENERATION ENGINES — optional.
# ------------------------------------------------------------------------------
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
GROQ_API_KEY=""
CEREBRAS_API_KEY=""

# ------------------------------------------------------------------------------
# SOCIAL CONTENT SCHEDULER (Vercel cron) — optional.
# ------------------------------------------------------------------------------
CONTENT_CRON_ENABLED="false"
CONTENT_CADENCE_HOURS="24"
# 1-year content plan tunables (defaults shown):
CONTENT_PLAN_DRAFTS_PER_RUN="5"      # how many pending slots per cron run
CONTENT_PLAN_BATCH_SIZE="3"          # plan slots per single LLM call
CONTENT_PLAN_HORIZON_DAYS="10"       # how far ahead the planner looks
# Social image generation for drafts: "enabled" (always), "disabled" (never),
# or unset (auto: on when Facebook/Instagram/TikTok credentials exist).
CONTENT_GENERATE_IMAGES=""
FACEBOOK_ACCESS_TOKEN=""
FACEBOOK_PAGE_ID=""
# Instagram posting (via the Facebook/IG Graph API) once INSTAGRAM_BUSINESS_ACCOUNT_ID is set.
INSTAGRAM_BUSINESS_ACCOUNT_ID=""
LINKEDIN_ACCESS_TOKEN=""
LINKEDIN_URN=""
X_BEARER_TOKEN=""

# ------------------------------------------------------------------------------
# ANALYTICS / MARKETING — optional. Public, not secret.
# ------------------------------------------------------------------------------
NEXT_PUBLIC_GA_ID=""
NEXT_PUBLIC_FB_PIXEL=""
NEXT_PUBLIC_HOTJAR_ID=""

# ------------------------------------------------------------------------------
# FILE UPLOADS (UploadThing) — optional.
# ------------------------------------------------------------------------------
UPLOADTHING_APP_ID=""
UPLOADTHING_SECRET=""

# ------------------------------------------------------------------------------
# CLOUDFLARE (media/image transforms) — optional.
# ------------------------------------------------------------------------------
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_API_TOKEN=""

# ------------------------------------------------------------------------------
# VOICE AGENT (client-facing) �?" optional. Public.
# ------------------------------------------------------------------------------
NEXT_PUBLIC_VOICE_AGENT_HOST=""

# ------------------------------------------------------------------------------
# AUTONOMOUS OPS WATCHTOWER (/api/ops/watchtower) — optional. Safe defaults on.
# Runs on a schedule via GitHub Actions (.github/workflows/crons.yml).
# ------------------------------------------------------------------------------
OPS_AUTO_RETRY_STUCK="true"        # requeue "processing" jobs older than OPS_STUCK_JOB_MS
OPS_STUCK_JOB_MS="1800000"         # 30 min before a processing job is considered stuck
OPS_AUTO_DRAIN="true"              # watchtower drains the job queue itself each run
OPS_DRAIN_MAX="25"                 # max jobs drained per run
OPS_AUTO_RETRY_TRANSIENT="true"    # requeue failed jobs whose errors look transient (timeouts, 5xx, network)
OPS_AUTO_CONTENT="true"            # backfill overdue content-plan slots if none were generated in 12h
OPS_SUMMARY="true"                 # have the Ops subagent write a short LLM brief each run
OPS_PROBE_TIMEOUT_MS="8000"        # per-page probe timeout (ms)

# ------------------------------------------------------------------------------
# GOOGLE ADSENSE (blog articles) - optional. Public.
# The verification meta tag is already set in the root layout; create an ad unit
# in the AdSense dashboard and paste its slot id below to enable banner ads on
# blog article pages. Leave AD_SLOT empty to render a dashed placeholder instead.
# ------------------------------------------------------------------------------
NEXT_PUBLIC_ADSENSE_CLIENT="ca-pub-1299715274212521"
NEXT_PUBLIC_ADSENSE_AD_SLOT_BLOG=""
