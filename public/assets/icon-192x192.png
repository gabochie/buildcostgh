                <ul style="display: flex; list-style: none; gap: 30px; margin: 0; padding: 0;"><li><a href="https://buildcostgh.com/" style="color: white; text-decoration: none; font-weight: 500; transition: color 0.3s;">Home</a></li><li><a href="https://buildcostgh.com/blog" style="color: white; text-decoration: none; font-weight: 500; transition: color 0.3s;">Blog</a></li><li><a href="https://buildcostgh.com/calculator" style="color: #C9A84C; text-decoration: none; font-weight: bold; transition: color 0.3s;">Calculator</a></li><li><a href="https://buildcostgh.com/features" style="color: white; text-decoration: none; font-weight: 500; transition: color 0.3s;">Features</a></li><li><a href="https://buildcostgh.com/contact" style="color: white; text-decoration: none; font-weight: 500; transition: color 0.3s;">Contact</a></li><li><a href="https://buildcostgh.com/pricing" style="color: #C9A84C; text-decoration: none; font-weight: bold; transition: color 0.3s;">Pricing</a></li></ul>            </nav>
